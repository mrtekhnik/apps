{
  "id": "/apps/",
  "name": "Мои приложения",
  "short_name": "Приложения",
  "lang": "ru",
  "start_url": "/apps/",
  "scope": "/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "orientation": "any",
  "background_color": "#1d2733",
  "theme_color": "#1d2733",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Личные накопления",
      "short_name": "Накопления",
      "url": "/apps/?open=finance",
      "icons": [
        {
          "src": "/finance/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Мои шаблоны",
      "short_name": "Шаблоны",
      "url": "/apps/?open=templates",
      "icons": [
        {
          "src": "/templates/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Моя техническая база",
      "short_name": "Тех. база",
      "url": "/apps/?open=tech-base",
      "icons": [
        {
          "src": "/tech-base/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Просмотр DXF и PDF",
      "short_name": "DXF просмотр",
      "url": "/apps/?open=dxf-viewer",
      "icons": [
        {
          "src": "/dxf-viewer/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
